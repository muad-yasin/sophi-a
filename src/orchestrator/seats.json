{
  "cnc": {
    "role": "Command & Control",
    "model": "claude-sonnet-5",
    "provider": "anthropic",
    "invocation_mode": "claude-code-subprocess",
    "session": "continued via --resume",
    "chat_history": true,
    "workdir": ".workdirs/cnc",
    "requires": [{ "type": "binary", "name": "claude" }]
  },
  "advisor": {
    "role": "Advisor",
    "model": "claude-fable-5-1",
    "provider": "anthropic",
    "invocation_mode": "messages-api",
    "session": "stateless",
    "chat_history": false,
    "requires": [{ "type": "env", "name": "ANTHROPIC_API_KEY" }]
  },
  "plan-1": {
    "role": "Planning module",
    "default_chain": "plan-cheap",
    "invocation_mode": "relay-chain-subprocess",
